# /etc/rascar/carplay.env — runtime environment of rascar-carplay.
#
# Read by rascar-carplay.service (EnvironmentFile) and by
# /usr/local/sbin/rascar-carplay-run, so a hand-run attempt behaves exactly like
# one the service starts. Edit, then: sudo systemctl restart rascar-carplay
# (or just re-plug / restart the car). Every variable is listed with its
# default in docs/configuration.md; only the ones a new install needs are here.

# Kiosk compositor. "wayland" = cage on the Mali GPU (WebGL, GPU raster, maps
# are smooth). Unset = Xvfb, CPU-only rendering (slower, but no GPU needed).
RASCAR_COMPOSITOR=wayland

# Frames per second streamed to the car. 30 is the default. 25 costs ~20% less
# CPU (libx264), which matters on car power with no fan.
RASCAR_VIDEO_FPS=25

# Re-send Now Playing on an idle iAP2 link every 1.2 s. The head unit's
# acknowledgements of these messages are the only timestamp of "the car is
# still talking" in the logs. Harmless; keep on.
RASCAR_IAP2_HEARTBEAT=on

# Do not soft-reconnect the gadget when the car sends "40 51 wValue=0".
# Reconnecting there was tested and cuts a live session. Keep at 0.
RASCAR_STAY_DEVICE_REENUM=0

# Host label in the _carplay-ctrl mDNS record on the car link. Use the same
# name avahi publishes on that link (your board's hostname), so the car sees
# one name per address.
RASCAR_CTRL_HOSTLABEL=orangepi5-plus

# Hex dump of USB bulk / iAP2 / RTSP traffic into the run logs in
# /var/lib/rascar-debug. Very useful for bug reports; costs disk, not CPU.
RASCAR_WIRE_TRACE=1

# Network/USB capture per attempt in seconds (0 = off, "full" = whole session).
#RASCAR_CAPTURE_SECONDS=60

# Cap of the A76 cores while streaming, in kHz (0 = leave the governor alone).
#RASCAR_CPU_MAX_KHZ=1800000

# Patched cdc_ncm module (kernel/cdc_ncm/build.sh installs it here).
#RASCAR_CDC_NCM_KO=/usr/local/lib/rascar/modules/<uname -r>/cdc_ncm.ko

# PulseAudio source captured for the car's audio (default: monitor of the
# default output).
#RASCAR_AUDIO_SOURCE=

# Plain logs in the journal (no ANSI colours).
NO_COLOR=1

# The USB serial is random and persisted in /var/lib/rascar/usb_serial on the
# first run. The car remembers a "phone" by it, so leave it alone unless you
# need to pin a specific one (40 hex digits).
#RASCAR_USB_SERIAL=
